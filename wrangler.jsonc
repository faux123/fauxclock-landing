{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fauxclock-landing",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "fauxclock.canonspike.com/*", "zone_name": "canonspike.com" }
  ],
  "assets": {
    "directory": "."
  }
}
